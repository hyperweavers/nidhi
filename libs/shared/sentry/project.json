{
  "name": "shared-sentry",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/sentry/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}",
        "{workspaceRoot}/test-results/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/shared/sentry/jest.config.ts",
        "tsConfig": "libs/shared/sentry/tsconfig.spec.json"
      }
    },
    "test:patch": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/src/**/*", "{workspaceRoot}/coverage/{projectRoot}/lcov.info"],
      "cache": false,
      "options": {
        "command": "pnpm nx run shared-sentry:test --coverage --coverageReporters=lcov && node tools/scripts/check-patch-coverage.mjs {projectRoot}",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/shared/sentry/tsconfig.lib.json"
      }
    }
  }
}
