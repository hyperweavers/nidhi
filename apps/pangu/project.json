{
  "name": "pangu",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/pangu/src",
  "i18n": {
    "sourceLocale": "en-IN"
  },
  "tags": [],
  "targets": {
    "build": {
      "dependsOn": [
        "prebuild-version",
        "prebuild-sentry",
        "^build"
      ],
      "executor": "@angular-devkit/build-angular:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/pangu",
        "index": "apps/pangu/src/index.html",
        "browser": "apps/pangu/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/pangu/tsconfig.app.json",
        "inlineStyleLanguage": "css",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/pangu/public"
          }
        ],
        "styles": [
          "apps/pangu/src/styles.css"
        ],
        "scripts": [
          "node_modules/flowbite-datepicker/dist/js/datepicker-full.min.js"
        ]
      },
      "configurations": {
        "production": {
          "sourceMap": {
            "scripts": true,
            "hidden": true,
            "vendor": false
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all",
          "statsJson": true,
          "serviceWorker": "apps/pangu/ngsw-config.json"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "with-mocks": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/pangu/src/environments/mocks.ts",
              "with": "apps/pangu/src/environments/mocks-on.ts"
            }
          ]
        }
      }
    },
    "prebuild-version": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [
        "{projectRoot}/src/generated/version.ts"
      ],
      "inputs": [
        "{projectRoot}/version"
      ],
      "options": {
        "command": "node tools/scripts/generate-version.mjs {projectName}"
      }
    },
    "prebuild-sentry": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [
        "{projectRoot}/src/generated/sentry-config.ts"
      ],
      "inputs": [
        "{workspaceRoot}/.env"
      ],
      "options": {
        "command": "node tools/scripts/generate-sentry-env.mjs {projectName}"
      }
    },
    "serve": {
      "dependsOn": [
        "prebuild-version",
        "prebuild-sentry"
      ],
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "continuous": true,
      "configurations": {
        "production": {
          "buildTarget": "pangu:build:production"
        },
        "development": {
          "buildTarget": "pangu:build:development"
        },
        "with-mocks": {
          "buildTarget": "pangu:build:with-mocks"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "pangu:build"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "prebuild-version",
        "prebuild-sentry"
      ],
      "options": {
        "command": "tsc --noEmit -p apps/pangu/tsconfig.app.json"
      }
    },
    "test": {
      "dependsOn": [
        "prebuild-version",
        "prebuild-sentry"
      ],
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}",
        "{workspaceRoot}/test-results/{projectRoot}"
      ]
    },
    "test:patch": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "prebuild-version",
        "prebuild-sentry"
      ],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{workspaceRoot}/coverage/{projectRoot}/lcov.info"
      ],
      "cache": false,
      "options": {
        "command": "pnpm nx run pangu:test --coverage --coverageReporters=lcov && node tools/scripts/check-patch-coverage.mjs {projectRoot}",
        "cwd": "{workspaceRoot}"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "pangu:build",
        "port": 4200,
        "staticFilePath": "dist/apps/pangu/browser",
        "spa": true
      }
    }
  }
}
